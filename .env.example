# Set exactly ONE of the following:
ANTHROPIC_API_KEY=your-anthropic-key-here
# GEMINI_API_KEY=your-gemini-key-here
# OPENROUTER_API_KEY=your-openrouter-key-here

# Required for the REST API (api/main.py) — clients must send this value
# in the X-API-Key header.
API_KEY=your-shared-secret-here

# Origins allowed to call the API from a browser, comma-separated (the
# frontend's dev server under both names by default). Only needed if the
# frontend runs somewhere else.
# FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Path to the unzipped SAP NW RFC SDK (nwrfcsdk folder). Needed to read the
# PO from SAP during validation; the connection details themselves are
# entered in Settings.
# SAPNWRFC_HOME=C:\nwrfcsdk
